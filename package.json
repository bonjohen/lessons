  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "astro": "^6.3.1",
    "marked": "^18.0.3",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "pagefind": "^1.5.2"
  }
}
