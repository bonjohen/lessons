{
  "name": "lessons-hub",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "harvest": "python scripts/harvest_lessons.py",
    "validate:lessons": "python scripts/validate_lessons.py",
    "index": "npx pagefind --site dist",
