# Lessons Hub — Environment Variables
# Copy to .env and adjust for your deployment.

# ---------- Frontend (Astro) ----------

# Base URL for the RAG backend API.
# Astro exposes this at build time via import.meta.env.PUBLIC_API_BASE.
# Default (when unset): http://localhost:8000
PUBLIC_API_BASE=http://localhost:8000

# ---------- Backend (FastAPI) ----------

# Comma-separated list of allowed CORS origins.
# Default (when unset): http://localhost:4321,http://localhost:3000,http://127.0.0.1:4321,http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:4321,http://localhost:3000
