---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div class="tag-list">
  {tags.map((tag) => (
    <a href={`/tags/${tag}`} class="tag">{tag}</a>
  ))}
</div>

<style>
  .tag-list { display: flex; gap: 0.4rem; flex-wrap: wrap; }
  .tag {
    background: #e8f0fe;
    color: #1a56db;
    padding: 0.2em 0.6em;
    border-radius: 3px;
    font-size: 0.8rem;
    text-decoration: none;
  }
  .tag:hover { background: #c5d9f7; }
</style>
