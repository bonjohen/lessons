---
import { url } from '../lib/url';
---

<div id="chat-panel">
  <div id="chat-messages"></div>
  <form id="chat-form">
    <input type="text" id="chat-input" placeholder="Ask a question about your lessons..." autocomplete="off" />
    <button type="submit" id="chat-submit">Ask</button>
  </form>
  <p id="chat-status" class="status-msg"></p>
</div>

<script define:vars={{ baseUrl: import.meta.env.BASE_URL }}>
const API_BASE = 'http://localhost:8000';
const messagesEl = document.getElementById('chat-messages');
const form = document.getElementById('chat-form');
const input = document.getElementById('chat-input');
const submitBtn = document.getElementById('chat-submit');
const statusEl = document.getElementById('chat-status');

function setStatus(msg, isError = false) {
  statusEl.textContent = msg;
  statusEl.className = isError ? 'status-msg error' : 'status-msg';
}

function appendMessage(role, content, lessons) {
  const div = document.createElement('div');
  div.className = `chat-msg chat-${role}`;

  const body = document.createElement('div');
  body.className = 'msg-body';
  body.textContent = content;
  div.appendChild(body);

  if (lessons && lessons.length > 0) {
    const sources = document.createElement('div');
    sources.className = 'msg-sources';
    sources.innerHTML = '<strong>Relevant Lessons:</strong>';
    const list = document.createElement('ul');
    lessons.forEach(l => {
      const li = document.createElement('li');
      const a = document.createElement('a');
      const lessonPath = baseUrl.replace(/\/$/, '') + l.lesson_url;
      a.href = lessonPath;
      a.textContent = l.title;
      li.appendChild(a);
      const score = document.createElement('span');
      score.className = 'score';
      score.textContent = ` (${Math.round(l.similarity_score * 100)}%)`;
      li.appendChild(score);
      list.appendChild(li);
    });
    sources.appendChild(list);
    div.appendChild(sources);
  }

  messagesEl.appendChild(div);
  messagesEl.scrollTop = messagesEl.scrollHeight;
}

form.addEventListener('submit', async (e) => {
  e.preventDefault();
  const message = input.value.trim();
  if (!message) return;

  appendMessage('user', message);
  input.value = '';
  submitBtn.disabled = true;
  setStatus('Thinking...');

  try {
    const res = await fetch(`${API_BASE}/api/chat`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ message, top_k: 8 }),
    });

    if (!res.ok) throw new Error(`Backend returned ${res.status}`);

    const data = await res.json();
    appendMessage('assistant', data.answer, data.relevant_lessons);

    if (data.gap_detected) {
      setStatus('Note: This topic may have limited coverage in the lessons corpus.');
    } else {
      setStatus('');
    }
  } catch (err) {
    setStatus('Backend unavailable. Start the backend with: npm run backend', true);
    appendMessage('assistant', 'Unable to reach the RAG backend. Make sure it is running on localhost:8000.');
  } finally {
    submitBtn.disabled = false;
    input.focus();
  }
});

// Check backend on load
fetch(`${API_BASE}/health`)
  .then(r => r.json())
  .then(data => {
    if (data.corpus_status && data.corpus_status.chunk_count > 0) {
      setStatus(`Connected. ${data.corpus_status.chunk_count} chunks indexed.`);
    } else {
      setStatus('Backend connected but no chunks indexed. Run: npm run embed');
    }
  })
  .catch(() => {
    setStatus('Backend unavailable. Start with: npm run backend', true);
  });
</script>

<style>
  #chat-panel {
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 1rem;
    background: #fff;
  }

  #chat-messages {
    min-height: 200px;
    max-height: 500px;
    overflow-y: auto;
    margin-bottom: 1rem;
    padding: 0.5rem;
  }

  .chat-msg {
    margin-bottom: 1rem;
    padding: 0.75rem;
    border-radius: 6px;
  }

  .chat-user {
    background: #e8f0fe;
    text-align: right;
  }

  .chat-assistant {
    background: #f5f5f5;
  }

  .msg-body {
    white-space: pre-wrap;
    line-height: 1.6;
  }

  .msg-sources {
    margin-top: 0.75rem;
    padding-top: 0.5rem;
    border-top: 1px solid #ddd;
    font-size: 0.9rem;
  }

  .msg-sources ul {
    list-style: none;
    padding: 0;
    margin-top: 0.25rem;
  }

  .msg-sources li {
    padding: 0.2rem 0;
  }

  .score {
    color: #777;
    font-size: 0.8rem;
  }

  #chat-form {
    display: flex;
    gap: 0.5rem;
  }

  #chat-input {
    flex: 1;
    padding: 0.5rem 0.75rem;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 1rem;
  }

  #chat-submit {
    padding: 0.5rem 1.25rem;
    background: #2563eb;
    color: #fff;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 1rem;
  }

  #chat-submit:hover {
    background: #1d4ed8;
  }

  #chat-submit:disabled {
    background: #93c5fd;
    cursor: not-allowed;
  }

  .status-msg {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: #666;
  }

  .status-msg.error {
    color: #dc2626;
  }
</style>
