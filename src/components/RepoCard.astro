---
import type { Repo } from '../lib/data';
import { url } from '../lib/url';

interface Props {
  repo: Repo;
}

const { repo } = Astro.props;
---

<article class="repo-card">
  <h3><a href={url(`/repos/${repo.id}`)}>{repo.name}</a></h3>
  <div class="meta">
    <span>{repo.lesson_count} lesson{repo.lesson_count !== 1 ? 's' : ''}</span>
    {repo.recent_date && <span>Latest: {repo.recent_date}</span>}
    {repo.project_url && <a href={repo.project_url}>Project</a>}
  </div>
  {repo.tags.length > 0 && (
    <div class="tags">
      {repo.tags.slice(0, 8).map((tag) => (
        <a href={url(`/tags/${tag}`)} class="tag">{tag}</a>
      ))}
      {repo.tags.length > 8 && <span class="tag-more">+{repo.tags.length - 8} more</span>}
    </div>
  )}
</article>

<style>
  .repo-card {
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 1rem 1.25rem;
    margin-bottom: 0.75rem;
    background: var(--color-bg-surface);
  }

  .repo-card h3 { margin: 0 0 0.25rem; font-size: 1.1rem; }
  .repo-card h3 a { text-decoration: none; color: var(--color-text); }
  .repo-card h3 a:hover { color: var(--color-link); }

  .meta {
    display: flex;
    gap: 1rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .tag-more { font-size: 0.75rem; color: var(--color-text-muted); }
</style>
