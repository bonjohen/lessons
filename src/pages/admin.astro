---
import BaseLayout from '../layouts/BaseLayout.astro';
import { DEPLOYMENTS, workflowUrl } from '../lib/deployments';
import { url } from '../lib/url';
---

<BaseLayout title="Admin - Lessons Hub">
  <h1>Deployment Dashboard</h1>
  <p>Monitor and manage all deployment targets. Health checks run client-side against each backend's <code>/health</code> endpoint.</p>

  <div class="deploy-grid">
    {DEPLOYMENTS.map((dep) => (
      <div class="deploy-card" data-id={dep.id} data-api={dep.apiUrl}>
        <div class="card-header">
          <h3>{dep.name}</h3>
          <span class="health-dot" id={`health-${dep.id}`} title="Checking..."></span>
        </div>
        <p class="card-desc">{dep.description}</p>
        <p class="card-profile">Profile: <code>{dep.profile}</code></p>
        <div class="card-health-detail" id={`detail-${dep.id}`}></div>
        <div class="card-actions">
          {dep.siteUrl && (
            <a href={dep.siteUrl} target="_blank" rel="noopener noreferrer" class="action-link">Open Site</a>
          )}
          {dep.workflowFile && (
            <a href={workflowUrl(dep.workflowFile)} target="_blank" rel="noopener noreferrer" class="action-link deploy-link">Deploy</a>
          )}
          {dep.siteUrl && (
            <button class="action-link iframe-toggle" data-site={dep.siteUrl}>Preview</button>
          )}
        </div>
        <div class="card-iframe-container" id={`iframe-${dep.id}`} style="display: none;">
          {/* Iframe inserted by JS on toggle */}
        </div>
      </div>
    ))}
  </div>
</BaseLayout>

<script>
  /* Health checks */
  document.querySelectorAll('.deploy-card').forEach(card => {
    const id = card.getAttribute('data-id');
    const apiUrl = card.getAttribute('data-api');
    const dot = document.getElementById(`health-${id}`);
    const detail = document.getElementById(`detail-${id}`);

    if (!apiUrl) {
      if (dot) { dot.className = 'health-dot na'; dot.title = 'No backend'; }
      if (detail) detail.textContent = 'Static only — no backend';
      return;
    }

    fetch(`${apiUrl}/health`, { signal: AbortSignal.timeout(5000) })
      .then(r => r.json())
      .then(data => {
        if (dot) { dot.className = 'health-dot up'; dot.title = 'Healthy'; }
        if (detail) {
          const chunks = data.corpus_status?.chunk_count ?? 'N/A';
          detail.textContent = `Chunks: ${chunks}`;
        }
      })
      .catch(() => {
        if (dot) { dot.className = 'health-dot down'; dot.title = 'Unreachable'; }
        if (detail) detail.textContent = 'Unreachable';
      });
  });

  /* Iframe toggles */
  document.querySelectorAll('.iframe-toggle').forEach(btn => {
    btn.addEventListener('click', () => {
      const siteUrl = btn.getAttribute('data-site');
      const card = btn.closest('.deploy-card');
      if (!card) return;
      const id = card.getAttribute('data-id');
      const container = document.getElementById(`iframe-${id}`);
      if (!container) return;

      if (container.style.display === 'none') {
        container.style.display = 'block';
        if (!container.querySelector('iframe')) {
          const iframe = document.createElement('iframe');
          iframe.src = siteUrl;
          iframe.setAttribute('loading', 'lazy');
          iframe.setAttribute('sandbox', 'allow-scripts allow-same-origin');
          container.appendChild(iframe);
        }
        btn.textContent = 'Hide Preview';
      } else {
        container.style.display = 'none';
        btn.textContent = 'Preview';
      }
    });
  });
</script>

<style>
  .deploy-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .deploy-card {
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 1rem;
    background: #fff;
  }

  .card-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .card-header h3 {
    margin: 0;
    font-size: 1.1rem;
  }

  .health-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
    background: #fbbf24;
    flex-shrink: 0;
  }

  .health-dot.up { background: #22c55e; }
  .health-dot.down { background: #ef4444; }
  .health-dot.na { background: #d1d5db; }

  .card-desc {
    font-size: 0.85rem;
    color: #555;
    margin-bottom: 0.25rem;
  }

  .card-profile {
    font-size: 0.8rem;
    color: #888;
    margin-bottom: 0.5rem;
  }

  .card-health-detail {
    font-size: 0.8rem;
    color: #666;
    margin-bottom: 0.75rem;
    min-height: 1.2em;
  }

  .card-actions {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .action-link {
    font-size: 0.8rem;
    padding: 0.3rem 0.6rem;
    border: 1px solid #ddd;
    border-radius: 4px;
    text-decoration: none;
    color: #2563eb;
    background: transparent;
    cursor: pointer;
    transition: all 0.12s ease;
  }

  .action-link:hover {
    background: #f0f7ff;
    border-color: #2563eb;
  }

  .deploy-link {
    color: #059669;
  }

  .deploy-link:hover {
    border-color: #059669;
    background: #ecfdf5;
  }

  .card-iframe-container {
    margin-top: 0.75rem;
  }

  .card-iframe-container :global(iframe) {
    width: 100%;
    height: 400px;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
  }
</style>
