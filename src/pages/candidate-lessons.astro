---
import BaseLayout from '../layouts/BaseLayout.astro';
const publicApiBase = import.meta.env.PUBLIC_API_BASE || '';
---

<BaseLayout title="Candidate Lessons - Lessons Hub">
  <h1>Candidate External Lessons</h1>
  <p>Lessons generated from external GitHub projects to fill corpus gaps. These require human review before inclusion.</p>

  <div id="candidates-status" class="status-msg">Loading...</div>
  <div id="candidates-list"></div>

  <h2>Coordination TODOs</h2>
  <div id="todos-status" class="status-msg">Loading...</div>
  <div id="todos-list"></div>
</BaseLayout>

<script define:vars={{ publicApiBase }}>
const API_BASE = publicApiBase || 'http://localhost:8010';

async function loadCandidates() {
  const statusEl = document.getElementById('candidates-status');
  const listEl = document.getElementById('candidates-list');
  try {
    const res = await fetch(`${API_BASE}/api/todos`);
    if (!res.ok) throw new Error(`${res.status}`);
    const data = await res.json();
    if (data.total === 0) {
      statusEl.textContent = 'No candidate lessons staged yet.';
      return;
    }
    statusEl.textContent = `${data.total} coordination item(s).`;
    listEl.innerHTML = '';
    for (const todo of data.todos) {
      const card = document.createElement('div');
      card.className = 'candidate-card';

      const h3 = document.createElement('h3');
      h3.textContent = todo.title;
      card.appendChild(h3);

      const p = document.createElement('p');
      p.textContent = todo.notes;
      card.appendChild(p);

      const meta = document.createElement('div');
      meta.className = 'meta';

      const statusSpan = document.createElement('span');
      statusSpan.textContent = `Status: ${todo.status}`;
      meta.appendChild(statusSpan);

      const prioritySpan = document.createElement('span');
      prioritySpan.textContent = `Priority: ${todo.priority}`;
      meta.appendChild(prioritySpan);

      if (todo.source_project_url) {
        const link = document.createElement('a');
        link.href = todo.source_project_url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.textContent = 'Source Project';
        meta.appendChild(link);
      }

      card.appendChild(meta);
      listEl.appendChild(card);
    }
  } catch {
    statusEl.textContent = 'Backend unavailable.';
    statusEl.className = 'status-msg error';
  }
}

loadCandidates();
</script>

<style>
  .candidate-card {
    border: 1px solid var(--color-border);
    border-left: 4px solid var(--color-warning);
    border-radius: 6px;
    padding: 1rem;
    margin-bottom: 0.75rem;
    background: var(--color-bg-surface);
  }

  .candidate-card h3 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
  }

  .meta {
    display: flex;
    gap: 1rem;
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-top: 0.5rem;
  }

  .status-msg {
    margin-bottom: 1rem;
    color: var(--color-footer-text);
    font-size: 0.9rem;
  }

  .status-msg.error {
    color: var(--color-error);
  }
</style>
