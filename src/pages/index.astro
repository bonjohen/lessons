---
import BaseLayout from '../layouts/BaseLayout.astro';
import LessonCard from '../components/LessonCard.astro';
import { getLessons, getRepos, getTags } from '../lib/data';
import { url } from '../lib/url';

const lessons = getLessons();
const repos = getRepos();
const tags = getTags();

// Recent lessons: sorted by date desc, limit 10
const recent = [...lessons]
  .filter((l) => l.date)
  .sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''))
  .slice(0, 10);
---

<BaseLayout title="Lessons Hub">
  <h1>Lessons Hub</h1>
  <p>A searchable library of engineering lessons learned across projects.</p>

  <section>
    <h2>At a Glance</h2>
    <ul class="stats">
      <li><strong>{repos.length}</strong> Repos</li>
      <li><strong>{lessons.length}</strong> Lessons</li>
      <li><strong>{tags.length}</strong> Tags</li>
    </ul>
  </section>

  <section>
    <h2>Recent Lessons</h2>
    {recent.length > 0 ? (
      recent.map((lesson) => <LessonCard lesson={lesson} />)
    ) : (
      <p><em>No dated lessons yet.</em></p>
    )}
  </section>

  <section>
    <h2>Browse</h2>
    <ul>
      <li><a href={url('/lessons/')}>All Lessons</a></li>
      <li><a href={url('/repos/')}>Repos</a></li>
      <li><a href={url('/tags/')}>Tags</a></li>
      <li><a href={url('/phases/')}>Phases</a></li>
      <li><a href={url('/types/')}>Types</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  .stats {
    display: flex;
    gap: 2rem;
    list-style: none;
    padding: 1rem 0;
  }

  .stats li {
    font-size: 1.1rem;
  }

  .stats strong {
    font-size: 1.5rem;
    display: block;
  }
</style>
