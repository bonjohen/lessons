---
import BaseLayout from '../layouts/BaseLayout.astro';
import LessonCard from '../components/LessonCard.astro';
import LessonCarousel from '../components/LessonCarousel.astro';
import { getLessons, getRepos, getTags } from '../lib/data';
import { url } from '../lib/url';

const lessons = getLessons();
const repos = getRepos();
const tags = getTags();

// Extract a plain-text blurb from markdown content
function extractBlurb(lesson: any): string {
  if (lesson.summary) return lesson.summary;
  // Strip markdown headings, links, images, bold/italic, then take first 160 chars
  const plain = (lesson.content || '')
    .replace(/^#{1,6}\s+.*$/gm, '')   // headings
    .replace(/!?\[([^\]]*)\]\([^)]*\)/g, '$1') // links/images
    .replace(/[*_`~]/g, '')           // inline formatting
    .replace(/\n{2,}/g, ' ')          // collapse paragraphs
    .replace(/\n/g, ' ')
    .trim();
  return plain.slice(0, 160) + (plain.length > 160 ? '...' : '') || lesson.title;
}

// Featured lessons: curated picks for broad value and topic diversity
const featuredIds = [
  'certification-15-design-first-development',
  'artemis-block6-054-phased-autonomous-execution',
  'qr-bracelet-product-positioning-drives-technical-decisions',
  'lessons-hub-adapter-pattern-for-multi-cloud',
  'jobclass-07-idempotent-pipelines',
  'diagram-canonical-model-single-source-of-truth',
  'morelessons-xss-in-llm-chat-interfaces',
  'qr-bracelet-client-side-pdf-generation',
  'artemis-block1-resume-safe-pipeline-design',
  'lessons-hub-five-stage-design-to-execution',
];
const featuredMap = new Map(lessons.map(l => [l.id, l]));
const featured = featuredIds
  .map(id => featuredMap.get(id))
  .filter(Boolean)
  .map(l => ({ ...l, blurb: extractBlurb(l!) }));

// Recent lessons: sorted by date desc, limit 10
const recent = [...lessons]
  .filter((l) => l.date)
  .sort((a, b) => (b.date ?? '').localeCompare(a.date ?? ''))
  .slice(0, 10);
---

<BaseLayout title="Lessons Hub">
  <h1>Lessons Hub</h1>
  <p>Browse, search, and query engineering lessons harvested from multiple GitHub repositories. Features full-text search, AI-powered chat with RAG, corpus gap detection, and multi-cloud deployment.</p>
  <p><a href={url('/about/')}>Learn how it works &rarr;</a></p>

  <section>
    <h2>At a Glance</h2>
    <ul class="stats">
      <li><strong>{repos.length}</strong> Repos</li>
      <li><strong>{lessons.length}</strong> Lessons</li>
      <li><strong>{tags.length}</strong> Tags</li>
    </ul>
  </section>

  <LessonCarousel lessons={featured} />

  <section>
    <h2>Recent Lessons</h2>
    {recent.length > 0 ? (
      recent.map((lesson) => <LessonCard lesson={lesson} />)
    ) : (
      <p><em>No dated lessons yet.</em></p>
    )}
  </section>

  <section>
    <h2>Browse</h2>
    <ul>
      <li><a href={url('/lessons/')}>All Lessons</a></li>
      <li><a href={url('/repos/')}>Repos</a></li>
      <li><a href={url('/tags/')}>Tags</a></li>
      <li><a href={url('/phases/')}>Phases</a></li>
      <li><a href={url('/types/')}>Types</a></li>
    </ul>
  </section>
</BaseLayout>

<style>
  .stats {
    display: flex;
    gap: 2rem;
    list-style: none;
    padding: 1rem 0;
  }

  .stats li {
    font-size: 1.1rem;
  }

  .stats strong {
    font-size: 1.5rem;
    display: block;
  }
</style>
