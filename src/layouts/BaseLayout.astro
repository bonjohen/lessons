---
import { url } from '../lib/url';
import '../styles/tags.css';

interface Props {
  title?: string;
}

const { title = 'Lessons Hub' } = Astro.props;
const apiBase = import.meta.env.PUBLIC_API_BASE || 'http://localhost:8011';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="Content-Security-Policy" content={`default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' ${apiBase} http://localhost:* https:; frame-src 'self' http://localhost:* https:; img-src 'self' data:;`} />
    <title>{title}</title>
    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        const theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <header>
      <nav>
        <a href={url('/')} class="site-title">Lessons Hub</a>
        <ul>
          <li><a href={url('/lessons/')}>Lessons</a></li>
          <li><a href={url('/repos/')}>Repos</a></li>
          <li><a href={url('/tags/')}>Tags</a></li>
          <li><a href={url('/phases/')}>Phases</a></li>
          <li><a href={url('/types/')}>Types</a></li>
          <li><a href={url('/ask/')}>Ask</a></li>
          <li><a href={url('/gaps/')}>Gaps</a></li>
          <li><a href={url('/about/')}>About</a></li>
        </ul>
        <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme" title="Toggle dark/light mode">
          <span class="theme-icon-light">&#9788;</span>
          <span class="theme-icon-dark">&#9790;</span>
        </button>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>Lessons Hub &mdash; a lessons-learned library across projects.</p>
      <p class="footer-links">
        <a href={url('/about/')}>About</a> &middot;
        <a href="https://github.com/bonjohen/lessons">GitHub</a> &middot;
        <a href={url('/admin/')}>Admin</a>
      </p>
    </footer>
  </body>
</html>

<script is:inline>
  (function() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;
    btn.addEventListener('click', function() {
      const current = document.documentElement.getAttribute('data-theme');
      const next = current === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
    });
  })();
</script>

<style is:global>
  :root {
    --color-text: #1a1a1a;
    --color-text-secondary: #555;
    --color-text-muted: #777;
    --color-text-faint: #888;
    --color-bg: #fafafa;
    --color-bg-surface: #fff;
    --color-bg-subtle: #f8f9fa;
    --color-bg-code: #f0f0f0;
    --color-border: #e0e0e0;
    --color-border-light: #ddd;
    --color-border-faint: #ccc;
    --color-link: #2563eb;
    --color-link-hover: #1d4ed8;
    --color-accent: #2563eb;
    --color-tag-bg: #e8f0fe;
    --color-tag-text: #1a56db;
    --color-tag-hover: #c5d9f7;
    --color-chip-bg: #f0f7ff;
    --color-chip-border: #c5d9f7;
    --color-chip-hover-bg: #dbeafe;
    --color-table-header: #f5f5f5;
    --color-success: #22c55e;
    --color-error: #ef4444;
    --color-warning: #fbbf24;
    --color-status-na: #d1d5db;
    --color-status-draft-bg: #fef3c7;
    --color-status-draft-text: #92400e;
    --color-status-superseded-bg: #fce7f3;
    --color-status-superseded-text: #9d174d;
    --color-status-deprecated-bg: #fee2e2;
    --color-status-deprecated-text: #991b1b;
    --color-footer-text: #666;
    --color-btn-text: #666;
    --color-btn-border: #ddd;
  }

  [data-theme="dark"] {
    --color-text: #e0e0e0;
    --color-text-secondary: #aaa;
    --color-text-muted: #888;
    --color-text-faint: #666;
    --color-bg: #121212;
    --color-bg-surface: #1e1e1e;
    --color-bg-subtle: #252525;
    --color-bg-code: #2a2a2a;
    --color-border: #333;
    --color-border-light: #3a3a3a;
    --color-border-faint: #444;
    --color-link: #60a5fa;
    --color-link-hover: #93c5fd;
    --color-accent: #3b82f6;
    --color-tag-bg: #1e3a5f;
    --color-tag-text: #93c5fd;
    --color-tag-hover: #2a4a6f;
    --color-chip-bg: #1a2e44;
    --color-chip-border: #2a4a6f;
    --color-chip-hover-bg: #223d5a;
    --color-table-header: #2a2a2a;
    --color-status-na: #4b5563;
    --color-status-draft-bg: #422006;
    --color-status-draft-text: #fbbf24;
    --color-status-superseded-bg: #4a0e2b;
    --color-status-superseded-text: #f472b6;
    --color-status-deprecated-bg: #450a0a;
    --color-status-deprecated-text: #fca5a5;
    --color-footer-text: #888;
    --color-btn-text: #999;
    --color-btn-border: #444;
    --pagefind-ui-primary: #60a5fa;
    --pagefind-ui-text: #e0e0e0;
    --pagefind-ui-background: #1e1e1e;
    --pagefind-ui-border: #333;
    --pagefind-ui-tag: #333;
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  body {
    font-family: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    line-height: 1.6;
    color: var(--color-text);
    background: var(--color-bg);
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  header {
    border-bottom: 1px solid var(--color-border);
    padding: 1rem 0;
    margin-bottom: 2rem;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
  }

  .site-title {
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--color-text);
  }

  nav ul {
    display: flex;
    list-style: none;
    gap: 1.25rem;
  }

  nav a {
    color: var(--color-link);
    text-decoration: none;
  }

  nav a:hover {
    text-decoration: underline;
  }

  .theme-toggle {
    margin-left: auto;
    background: transparent;
    border: 1px solid var(--color-btn-border);
    border-radius: 4px;
    cursor: pointer;
    width: 32px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    color: var(--color-btn-text);
    transition: border-color 0.12s ease, color 0.12s ease;
  }

  .theme-toggle:hover {
    border-color: var(--color-text);
    color: var(--color-text);
  }

  [data-theme="dark"] .theme-icon-light { display: inline; }
  [data-theme="dark"] .theme-icon-dark { display: none; }
  [data-theme="light"] .theme-icon-light,
  :root:not([data-theme="dark"]) .theme-icon-light { display: none; }
  [data-theme="light"] .theme-icon-dark,
  :root:not([data-theme="dark"]) .theme-icon-dark { display: inline; }

  main {
    min-height: 60vh;
    padding-bottom: 2rem;
  }

  footer {
    border-top: 1px solid var(--color-border);
    padding: 1.5rem 0;
    margin-top: 2rem;
    color: var(--color-footer-text);
    font-size: 0.875rem;
  }

  .footer-links {
    margin-top: 0.25rem;
  }

  .footer-links a {
    color: var(--color-footer-text);
    text-decoration: none;
  }

  .footer-links a:hover {
    text-decoration: underline;
    color: var(--color-link);
  }

  h1 { font-size: 2rem; margin-bottom: 1rem; }
  h2 { font-size: 1.5rem; margin: 1.5rem 0 0.75rem; }
  h3 { font-size: 1.25rem; margin: 1.25rem 0 0.5rem; }
  p { margin-bottom: 0.75rem; }

  a {
    color: var(--color-link);
  }

  code {
    background: var(--color-bg-code);
    padding: 0.15em 0.35em;
    border-radius: 3px;
    font-size: 0.9em;
  }

  pre {
    background: var(--color-bg-code);
    padding: 1rem;
    border-radius: 4px;
    overflow-x: auto;
    margin-bottom: 1rem;
  }

  pre code {
    background: none;
    padding: 0;
  }

  .breadcrumb {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .tag {
    background: var(--color-tag-bg);
    color: var(--color-tag-text);
    padding: 0.2em 0.6em;
    border-radius: 3px;
    font-size: 0.8rem;
    text-decoration: none;
  }

  .tag:hover {
    background: var(--color-tag-hover);
  }
</style>
